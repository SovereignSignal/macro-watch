# Local dev points at the Railway dev database (Global Constraint 7).
DATABASE_URL=postgres://user:password@host:5432/railway
# Generate with: openssl rand -hex 32
MACRO_WATCH_INGEST_TOKEN=change-me
SITE_URL=http://localhost:3000
# Extra paywalled-publisher substrings, comma-separated. Bloomberg is always blocked.
# BLOCKED_PUBLISHERS=economist.com,ft.com,wsj.com

# Members-only area (/track-record, /accountability, claim data elsewhere).
# Shared password members type into the sign-in form. If unset, nobody can
# sign in (the gate fails closed) and the notice says sign-in is not available.
SITE_MEMBER_PASSWORD=
# Secret used to sign the "sm_member" cookie. Optional: if unset, it is derived
# from SITE_MEMBER_PASSWORD (so changing the password signs everyone out).
# Set it to keep sessions across password changes.
# Generate with: openssl rand -hex 32
# SITE_MEMBER_SECRET=
